{
  "name": "fast-lanche",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode legacy && vite build --mode react",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "node --test tests/*.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/**/*.jsx --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 tests/*.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/quality/a11y.spec.js --project=chromium",
    "test:perf": "playwright test --project=performance --no-deps",
    "test:all": "npm test && npm run test:e2e",
    "release:check": "npm run test:coverage && npm run build && npm run verify:dist && npm run test:e2e",
    "og:image": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
